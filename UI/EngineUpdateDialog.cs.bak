using FileTypeAnalyzer.Core;

namespace FileTypeAnalyzer.UI;

public sealed class EngineUpdateDialog : Form
{
    private readonly EngineUpdater _updater;
    private readonly string _tridDefsPath;
    private readonly string _magikaExePath;

    private readonly Label _tridStatus = new();
    private readonly Label _magikaStatus = new();
    private readonly Button _tridUpdateBtn = new();
    private readonly Button _magikaUpdateBtn = new();
    private readonly TextBox _logBox = new();

    public bool TridUpdated { get; private set; }
    public bool MagikaUpdated { get; private set; }

    public EngineUpdateDialog(EngineUpdater updater, string tridDefsPath, string magikaExePath)
    {
        _updater = updater;
        _tridDefsPath = tridDefsPath;
        _magikaExePath = magikaExePath;
        InitializeDialog();
        _ = RefreshMagikaVersionAsync();
    }

    private void InitializeDialog()
    {
        Text = Localization.T("update.title");
        StartPosition = FormStartPosition.CenterParent;
        ClientSize = new Size(620, 420);
        BackColor = Theme.Panel;
        ForeColor = Theme.TextMain;
        Font = Theme.Sans;
        FormBorderStyle = FormBorderStyle.FixedDialog;
        MaximizeBox = false;
        MinimizeBox = false;

        var root = new TableLayoutPanel
        {
            Dock = DockStyle.Fill, ColumnCount = 1, RowCount = 3,
            Padding = new Padding(16), BackColor = Theme.Panel
        };
        root.RowStyles.Add(new RowStyle(SizeType.AutoSize));
        root.RowStyles.Add(new RowStyle(SizeType.AutoSize));
        root.RowStyles.Add(new RowStyle(SizeType.Percent, 100));

        // TrID 行
        var tridRow = new TableLayoutPanel
        {
            Dock = DockStyle.Fill, ColumnCount = 2, RowCount = 2,
            AutoSize = true, Margin = new Padding(0, 0, 0, 16)
        };
        tridRow.ColumnStyles.Add(new ColumnStyle(SizeType.Percent, 100));
        tridRow.ColumnStyles.Add(new ColumnStyle(SizeType.AutoSize));
        tridRow.Controls.Add(new Label
        {
            Text = Localization.T("update.trid.label"), Font = Theme.SansBold,
            ForeColor = Theme.TextMain, AutoSize = true, Margin = new Padding(0, 0, 0, 4)
        }, 0, 0);
        _tridStatus.Text = File.Exists(_tridDefsPath)
            ? Localization.T("update.trid.exists")
            : Localization.T("update.trid.notFound");
        _tridStatus.ForeColor = File.Exists(_tridDefsPath) ? Theme.TextMuted : Theme.Warn;
        _tridStatus.Font = Theme.SansSmall; _tridStatus.AutoSize = true;
        tridRow.Controls.Add(_tridStatus, 0, 1);
        _tridUpdateBtn.Text = Localization.T("update.trid.button");
        StyleUpdateButton(_tridUpdateBtn);
        _tridUpdateBtn.Click += async (_, _) => await UpdateTridAsync();
        tridRow.Controls.Add(_tridUpdateBtn, 1, 0);
        tridRow.SetRowSpan(_tridUpdateBtn, 2);

        // Magika 行
        var magikaRow = new TableLayoutPanel
        {
            Dock = DockStyle.Fill, ColumnCount = 2, RowCount = 2,
            AutoSize = true, Margin = new Padding(0, 0, 0, 16)
        };
        magikaRow.ColumnStyles.Add(new ColumnStyle(SizeType.Percent, 100));
        magikaRow.ColumnStyles.Add(new ColumnStyle(SizeType.AutoSize));
        magikaRow.Controls.Add(new Label
        {
            Text = Localization.T("update.magika.label"), Font = Theme.SansBold,
            ForeColor = Theme.TextMain, AutoSize = true, Margin = new Padding(0, 0, 0, 4)
        }, 0, 0);
        _magikaStatus.Text = File.Exists(_magikaExePath)
            ? Localization.T("update.magika.detecting")
            : Localization.T("update.magika.notInstalled");
        _magikaStatus.ForeColor = Theme.TextMuted; _magikaStatus.Font = Theme.SansSmall;
        _magikaStatus.AutoSize = true;
        magikaRow.Controls.Add(_magikaStatus, 0, 1);
        _magikaUpdateBtn.Text = Localization.T("update.magika.checkButton");
        StyleUpdateButton(_magikaUpdateBtn);
        _magikaUpdateBtn.Click += async (_, _) => await UpdateMagikaAsync();
        magikaRow.Controls.Add(_magikaUpdateBtn, 1, 0);
        magikaRow.SetRowSpan(_magikaUpdateBtn, 2);

        _logBox.Multiline = true; _logBox.ReadOnly = true;
        _logBox.ScrollBars = ScrollBars.Vertical; _logBox.Dock = DockStyle.Fill;
        _logBox.BackColor = Theme.DarkBg; _logBox.ForeColor = Theme.TextMuted;
        _logBox.Font = Theme.Mono; _logBox.BorderStyle = BorderStyle.None;

        root.Controls.Add(tridRow, 0, 0);
        root.Controls.Add(magikaRow, 0, 1);
        root.Controls.Add(_logBox, 0, 2);
        Controls.Add(root);
    }

    private static void StyleUpdateButton(Button b)
    {
        b.FlatStyle = FlatStyle.Flat; b.BackColor = Theme.Primary; b.ForeColor = Color.White;
        b.Font = Theme.Sans; b.AutoSize = true; b.Padding = new Padding(12, 4, 12, 4);
        b.FlatAppearance.BorderSize = 0;
        b.FlatAppearance.MouseOverBackColor = Theme.PrimaryHover;
        b.Cursor = Cursors.Hand; b.Margin = new Padding(8, 0, 0, 0);
    }

    private void AppendLog(string msg) =>
        _logBox.AppendText($"[{DateTime.Now:HH:mm:ss}] {msg}{Environment.NewLine}");

    private async Task UpdateTridAsync()
    {
        _tridUpdateBtn.Enabled = false;
        try
        {
            var kbProgress = new Progress<string>(AppendLog);
            var msg = await _updater.UpdateTridDefsAsync(_tridDefsPath, kbProgress);
            TridUpdated = true;
            _tridStatus.Text = msg;
            _tridStatus.ForeColor = Theme.Good;
            AppendLog(Localization.T("update.log.ok", msg));
        }
        catch (Exception ex)
        {
            _tridStatus.Text = Localization.T("update.trid.failed");
            _tridStatus.ForeColor = Theme.Bad;
            AppendLog(Localization.T("update.log.fail", "TrID", ex.Message));
        }
        finally { _tridUpdateBtn.Enabled = true; }
    }

    private async Task RefreshMagikaVersionAsync()
    {
        if (!File.Exists(_magikaExePath))
        {
            _magikaStatus.Text = Localization.T("update.magika.notInstalledHint");
            _magikaStatus.ForeColor = Theme.Warn;
            _magikaUpdateBtn.Enabled = false;
            return;
        }
        try
        {
            var (hasUpdate, latestTag, _) = await _updater.CheckMagikaUpdateAsync(_magikaExePath);
            _magikaStatus.Text = hasUpdate
                ? Localization.T("update.magika.hasUpdate", latestTag)
                : Localization.T("update.magika.latest");
            _magikaStatus.ForeColor = hasUpdate ? Theme.Warn : Theme.Good;
            _magikaUpdateBtn.Text = hasUpdate
                ? Localization.T("update.trid.button")
                : Localization.T("update.magika.recheckButton");
        }
        catch (Exception ex)
        {
            _magikaStatus.Text = Localization.T("update.magika.checkFailed", ex.Message);
            _magikaStatus.ForeColor = Theme.TextMuted;
        }
    }

    private async Task UpdateMagikaAsync()
    {
        _magikaUpdateBtn.Enabled = false;
        try
        {
            var (hasUpdate, latestTag, downloadUrl) =
                await _updater.CheckMagikaUpdateAsync(_magikaExePath);
            if (!hasUpdate)
            {
                AppendLog(Localization.T("update.magika.alreadyLatest"));
                return;
            }
            if (string.IsNullOrEmpty(downloadUrl))
                throw new InvalidOperationException(Localization.T("update.magika.noDownload"));

            AppendLog(Localization.T("update.magika.downloading", latestTag));
            var msg = await _updater.UpdateMagikaCliAsync(_magikaExePath, downloadUrl,
                new Progress<string>(AppendLog));
            MagikaUpdated = true;
            AppendLog(Localization.T("update.log.ok", msg));
            _magikaStatus.Text = Localization.T("update.magika.updated");
            _magikaStatus.ForeColor = Theme.Good;
        }
        catch (Exception ex)
        {
            _magikaStatus.Text = Localization.T("update.magika.failed");
            _magikaStatus.ForeColor = Theme.Bad;
            AppendLog(Localization.T("update.log.fail", "Magika", ex.Message));
        }
        finally { _magikaUpdateBtn.Enabled = true; }
    }
}