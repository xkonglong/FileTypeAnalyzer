<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- TrID 改用托管引擎，无原生 32 位依赖，进程不再限制位数 -->
    <PlatformTarget>anycpu</PlatformTarget>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>FileTypeAnalyzer</AssemblyName>
    <RootNamespace>FileTypeAnalyzer</RootNamespace>
    <Version>1.1.0</Version>
    <ApplicationIcon>FileTypeAnalyzer.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- 窗体图标与 exe 图标使用同一个 .ico：嵌入后由 AppInfo.LoadIcon 读取，替换图标只需重新编译 -->
    <EmbeddedResource Include="FileTypeAnalyzer.ico" LogicalName="app.ico" />
    <!-- 图标字体随程序打包，避免依赖系统是否装有 Segoe Fluent Icons -->
    <EmbeddedResource Include="assets\fa-solid-900.ttf" LogicalName="icons.ttf" />
    <Content Include="assets\FontAwesome-LICENSE.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Update="lang\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- TrID 托管引擎（NuGet 包 TriDEngine 1.2.4 中的 lib/net40/TrID.dll，纯 .NET，签名定义内置）
         以程序集引用方式引入，构建时自动复制到输出目录。 -->
    <Reference Include="TrID">
      <HintPath>assets\TrID.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>